// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  DONOR
  HOSPITAL
  ADMIN
}

enum BloodType {
  A_RH_POS
  A_RH_NEG
  B_RH_POS
  B_RH_NEG
  AB_RH_POS
  AB_RH_NEG
  O_RH_POS
  O_RH_NEG
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequestStatus {
  PENDING
  ACTIVE
  FULFILLED
  CANCELLED
  EXPIRED
}

enum TransactionStatus {
  ACCEPTED
  EN_ROUTE
  ARRIVED
  COMPLETED
  CANCELLED
}


model User {
  id           String   @id @default(uuid())
  phoneNumber  String   @unique
  password     String
  role         Role     @default(DONOR)
  isVerified   Boolean  @default(false) // SMS Onayı
  
  // KVKK ve Yasal Zorunluluklar
  kvkkConsent  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // İlişkiler
  donorProfile    DonorProfile?
  hospitalProfile HospitalProfile?

  createdRequests BloodRequest[]        @relation("Requester")
  donations       DonationTransaction[] @relation("DonorTransaction")

  @@map("users")
}

model DonorProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  firstName      String
  lastName       String
  identityNumber String?   
  
  bloodType      BloodType
  gender         Gender    // Bağış aralığı hesaplaması için (Erkek 3 ay, Kadın 4 ay)
  birthDate      DateTime
  weight         Int?      // 50kg altı kontrolü için
  
  lastDonationDate DateTime? 
  
  location Unsupported("geography(Point, 4326)")?

  totalDonations  Int     @default(0)
  trustScore      Float   @default(10.0) 
  @@index([userId])
  @@map("donor_profiles")
}

model HospitalProfile {
  id            String                        @id @default(uuid())
  userId        String                        @unique
  user          User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  licenseNumber String                        @unique
  address       String
  city          String

  location Unsupported("geography(Point, 4326)")

  @@map("hospital_profiles")
}

model BloodRequest {
  id          String   @id @default(uuid())
  
  requesterId String
  requester   User     @relation("Requester", fields: [requesterId], references: [id])

  hospitalName String
  bloodType    BloodType
  unitsNeeded  Int
  urgency      Urgency       @default(HIGH)
  status       RequestStatus @default(PENDING)
  description  String?
  
  location Unsupported("geography(Point, 4326)")
  
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  transactions DonationTransaction[]

 @@map("blood_requests")
 }

model DonationTransaction {
  id        String   @id @default(uuid())
  
  requestId String
  request   BloodRequest @relation(fields: [requestId], references: [id])
  
  donorId   String
  donor     User     @relation("DonorTransaction", fields: [donorId], references: [id])
  
  status    TransactionStatus @default(ACCEPTED)
  
  acceptedAt  DateTime @default(now())
  arrivedAt   DateTime?
  completedAt DateTime?

  @@unique([requestId, donorId])
  @@map("donation_transactions")
}